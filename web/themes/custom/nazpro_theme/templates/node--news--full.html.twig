<section class='telo-nac'>
  <section class='telo-nac'>
    <div class='text-pic-news'>
      <div class='left-news-vn'>
        <div class='develop-text'>
          {{ processed_body|raw }}
        </div>
        <div class='buts-news'>
          {{ attach_library('custom_news_navigation/news-navigation') }}
          {% if news_navigation_html %}
            {{ news_navigation_html }}
          {% endif %}
        </div>
      </div>
      <div class='oic-news-vn'>
        {% if content.field_news_image %}
        <img
          src="{{ file_url(node.field_news_image.entity.uri.value) }}"
          alt=""
          title=""
        />
        {% endif %}
      </div>
    </div>
  </section>
  <br></section>

