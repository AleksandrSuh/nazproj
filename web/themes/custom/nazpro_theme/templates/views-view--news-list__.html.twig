<div class="news-page">
  <h1 class="news-page__title">{{ title }}</h1>

  {% for row in rows %}
    {% set result = row['#row'] %}

    <article class="one-news">
      <a href="/news/{{ result.nid }}" class="pic-news">
        {% if result.field_news_image_target_id %}
          <img src="/sites/default/files/styles/medium/public/{{ result.field_news_image_target_id }}.jpg" alt="">
        {% endif %}
      </a>
      <a href="/news/{{ result.nid }}" class="name-news">
        {{ result.title }}
      </a>
      <div class="date-news">
        {{ result.field_news_date_value|date('d.m.Y') }}
      </div>
      <div class="anons-news">
        {{ result.field_news_summary_value|striptags|slice(0, 300) }}
      </div>
    </article>
  {% endfor %}

  {{ pager }}
</div>
